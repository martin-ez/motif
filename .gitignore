/target
**/*.rs.bk
*.pdb

# Merge and patch leftovers. Frequent here because short-lived branches rebase
# onto a moving main.
*.orig
*.rej

# Profiling and coverage output. Routine on a DSP codebase, and large.
perf.data
perf.data.old
flamegraph.svg
*.trace
*.profraw
*.profdata

# cargo-mutants writes a report directory beside the source on every real run.
/mutants.out
/mutants.out.old

# Agent worktrees live inside the repo and are not part of it. settings.json is
# shared configuration; settings.local.json is one person's machine.
/.claude/worktrees/
/.claude/settings.local.json

# Local audio captures and analysis scratch. Test fixtures live in
# tests/fixtures and are committed deliberately; anything else audio-shaped is
# scratch.
/scratch
/recordings

# Editor state. Project settings that are genuinely shared belong in a file
# that is not one person's window layout.
/.idea/

.DS_Store
